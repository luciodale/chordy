{
  "name": "chordy",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply chordy-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply chordy-db --local",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/react": "^5.0.6",
    "@fontsource/roboto-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.55.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "wrangler": "^4.54.0"
  }
}
